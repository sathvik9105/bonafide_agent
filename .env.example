# Copy to .env and fill in. .env must be in .gitignore before the first commit.

# --- LLM (Google AI Studio, free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=
GEMINI_MODEL_FAST=

# --- Anakin ---
ANAKIN_API_KEY=
ANAKIN_BASE_URL=https://api.anakin.io
# Verify the scrape path against the live API reference before use.
# The docs contradict themselves between /v1/scrape and /v1/url-scraper.

# --- Callback mailbox ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=BonaFide Verification
# dry = write to DB and log only. live = actually send.
# Default to dry. Only set live for the demo.
MAIL_MODE=dry
# Your own name. Outreach and disposition emails are signed with it and must read like you wrote them.
BONAFIDE_USER_NAME=
# Live-testing safety net: when set, every live email goes to this address instead of the real recipient.
MAIL_REDIRECT_TO=
# Mail servers (Gmail by default).
SMTP_HOST=smtp.gmail.com
IMAP_HOST=imap.gmail.com

# --- Behaviour ---
# Set to 0 for the live demo so the judge sees real network calls.
USE_CACHE=1
# Hard stop so a runaway loop can't drain the 300-credit budget.
MAX_CREDITS_PER_RUN=20
# SQLite file. Defaults to ./bonafide.db.
DB_PATH=
# Optional contact address for Crossref's polite pool (sent in the User-Agent).
CROSSREF_MAILTO=
